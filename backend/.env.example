# Application
APP_NAME=RE:WORK API
ENVIRONMENT=development
DEBUG=false
DEMO_MODE=true

# CORS — comma-separated browser origins allowed to call the API
# Development default: localhost:3000 (set explicitly for production)
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Persistence: memory (default) or postgres
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql+psycopg://rework:rework@localhost:5432/rework

# SAP product mode: SIMULATED | LIVE
# SIMULATED = prototype catalog + LLM demo; Student page can still use OData URL/credentials below.
SAP_MODE=SIMULATED
SAP_ODATA_BASE_URL=
SAP_ODATA_SERVICE=
SAP_ODATA_METADATA_URL=
SAP_TIMEOUT_SECONDS=15
SAP_AUTH_MODE=NONE
SAP_USERNAME=
SAP_PASSWORD=
# SAP_CLIENT_ID=
# SAP_CLIENT_SECRET=
# SAP_COMPANY_ID=
# SAP_API_URL=

# Seven-table EntitySets — fill only after inspecting official $metadata
SAP_ENTITY_USER=
SAP_ENTITY_SKILL=
SAP_ENTITY_PERSON_SKILL=
SAP_ENTITY_JOB=
SAP_ENTITY_JOB_SKILL=
SAP_ENTITY_ORGANIZATION=
SAP_ENTITY_HR=

# SAP_PROTOTYPE_FALLBACK=true uses prototype candidates/jobs when USER/JOB OData is not configured.
SAP_PROTOTYPE_FALLBACK=true

# Fixtures (learning catalog, golden cases) — relative to backend/ or repo root
FIXTURES_DIR=../fixtures

# LLM (optional — DEMO_MODE uses deterministic fallback when key is unset)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
