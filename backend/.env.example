# Application
APP_NAME=RE:WORK API
DEBUG=false
DEMO_MODE=true

# Persistence: memory (default) or postgres
PERSISTENCE_MODE=memory
DATABASE_URL=postgresql+psycopg://rework:rework@localhost:5432/rework

# SAP — default SIMULATED; set LIVE only with verified tenant credentials
SAP_MODE=SIMULATED
# SAP_API_URL=
# SAP_CLIENT_ID=
# SAP_CLIENT_SECRET=
# SAP_COMPANY_ID=

# LLM (optional — DEMO_MODE uses deterministic fallback)
# LLM_API_KEY=
